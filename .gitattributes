# Notebooks Jupyter: evita diffs ilegiveis por causa dos outputs embutidos
*.ipynb linguist-language=Python
*.ipynb -diff

# Normaliza quebras de linha (evita ruido entre Windows e Linux)
* text=auto

# Arquivos binarios: nunca tentar fazer diff nem normalizar
*.pdf binary
*.png binary
*.jpg binary
*.npy binary
*.npz binary
# Scripts da orientação: guardados byte a byte, sem normalizar a quebra de
# linha, para o hash continuar igual ao do arquivo recebido
scripts/orientacao/*.py -text
